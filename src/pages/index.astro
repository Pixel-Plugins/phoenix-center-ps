---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Announcement from '../components/layout/Announcement.astro';
import Hero from '../components/sections/Hero.astro';
import PillarsGrid from '../components/sections/PillarsGrid.astro';
import ApproachChecklist from '../components/sections/ApproachChecklist.astro';
import PartnersGrid from '../components/sections/PartnersGrid.astro';
import Newsletter from '../components/sections/Newsletter.astro';
import Section from '../components/ui/Section.astro';
// Testimonials and TeamGrid components exist (src/components/sections/) but
// aren't rendered below yet — no real client quotes or team bios exist.
import PublicationGrid from '../components/publications/PublicationGrid.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allPublications = (await getCollection('publications')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const books = allPublications.filter((p) => p.data.category === 'research-field-studies').slice(0, 4);
const papers = allPublications.filter((p) => p.data.category !== 'research-field-studies').slice(0, 4);
---

<BaseLayout title={lang === 'ar' ? 'الرئيسية' : 'Home'}>
  <Announcement />
  <Hero />
  <PillarsGrid />
  <ApproachChecklist />

  <Section
    id="publications"
    eyebrow={t('publications.eyebrow')}
    title={t('publications.booksTitle')}
  >
    <Fragment slot="head-action">
      <a class="link-underline" href={localizedPath('/publications/', lang)}>{t('publications.viewAll')}</a>
    </Fragment>
    <PublicationGrid entries={books} />
  </Section>

  <Section variant="tight" title={t('publications.papersTitle')}>
    <Fragment slot="head-action">
      <a class="link-underline" href={localizedPath('/publications/', lang)}>{t('publications.viewAll')}</a>
    </Fragment>
    <PublicationGrid entries={papers} variant="alt" />
  </Section>

  <PartnersGrid />
  <Newsletter />
</BaseLayout>
