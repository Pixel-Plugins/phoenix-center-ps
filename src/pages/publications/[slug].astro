---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import { getLangFromUrl, pickLocalized, localizedPath, useTranslations } from '../../i18n/utils';
import { publicationCategoryLabels } from '../../data/siteConfig';

export const getStaticPaths = (async () => {
  const entries = await getCollection('publications');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(entry);

const title = pickLocalized(entry.data.title, lang);
const categoryLabel = pickLocalized(publicationCategoryLabels[entry.data.category], lang);
const dateLabel = entry.data.date.toLocaleDateString(lang === 'ar' ? 'ar' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const all = (await getCollection('publications')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = all.findIndex((p) => p.id === entry.id);
const prev = currentIndex < all.length - 1 ? all[currentIndex + 1] : null;
const next = currentIndex > 0 ? all[currentIndex - 1] : null;

function neighborTitle(neighbor: typeof prev) {
  if (!neighbor) return null;
  return pickLocalized(neighbor.data.title, lang);
}
---

<BaseLayout title={title?.value ?? 'Publication'}>
  <article>
    <div class="pub-hero">
      <div class="pub-hero__media">
        <Image src={entry.data.coverImage} alt="" width={1600} height={900} />
      </div>
      <div class="pub-hero__inner" data-reveal>
        {categoryLabel && <span class="pub-hero__tag">{categoryLabel.value}</span>}
        {title && <h1 lang={title.lang} dir={title.dir}>{title.value}</h1>}
        <span class="pub-hero__date">{dateLabel}</span>
      </div>
    </div>

    <Section variant="tight">
      <div class="pub-body">
        <Content />
        {entry.data.pdf && (
          <a class="btn-download" href={entry.data.pdf} target="_blank" rel="noopener noreferrer">
            {t('publications.download')}
          </a>
        )}
      </div>

      <nav class="pub-neighbors">
        {prev ? (
          <a href={localizedPath(`/publications/${prev.id}/`, lang)} class="pub-neighbor">
            <span class="pub-neighbor__label">{t('publications.prev')}</span>
            <span lang={neighborTitle(prev)?.lang} dir={neighborTitle(prev)?.dir}>{neighborTitle(prev)?.value}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={localizedPath(`/publications/${next.id}/`, lang)} class="pub-neighbor pub-neighbor--end">
            <span class="pub-neighbor__label">{t('publications.next')}</span>
            <span lang={neighborTitle(next)?.lang} dir={neighborTitle(next)?.dir}>{neighborTitle(next)?.value}</span>
          </a>
        ) : <span />}
      </nav>
    </Section>
  </article>
</BaseLayout>

<style>
  .pub-hero { position: relative; }
  .pub-hero__media { height: 420px; overflow: hidden; }
  .pub-hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pub-hero__inner {
    background: var(--color-surface-inverse); padding: 32px var(--gutter) 40px;
  }
  .pub-hero__tag {
    display: inline-block; font-size: 12.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .05em; color: var(--sage); margin-bottom: 14px;
  }
  .pub-hero__inner h1 { font-size: 30px; line-height: 1.35; color: oklch(98% 0.005 85); max-width: 860px; margin: 0 0 14px; }
  .pub-hero__inner h1[dir='rtl'] { text-align: right; }
  .pub-hero__date { font-size: 13.5px; color: var(--ink-on-navy); }

  .pub-body { max-width: 760px; margin: 0 auto; font-size: 16px; line-height: 1.8; color: var(--color-text); }
  .pub-body :global(p) { margin: 0 0 20px; }
  .btn-download {
    display: inline-block; margin-top: 12px; background: var(--sage); color: var(--sage-ink);
    padding: 13px 26px; border-radius: var(--r-sm); text-decoration: none; font-weight: 700; font-size: 14.5px;
  }
  .btn-download:hover { background: var(--sage-hover); color: var(--sage-ink); }

  .pub-neighbors {
    max-width: 760px; margin: 56px auto 0; padding-top: 28px; border-top: 1px solid var(--color-border);
    display: flex; justify-content: space-between; gap: 24px;
  }
  .pub-neighbor { text-decoration: none; color: var(--color-text-strong); max-width: 320px; }
  .pub-neighbor--end { text-align: end; margin-inline-start: auto; }
  .pub-neighbor:hover { color: var(--eyebrow); }
  .pub-neighbor__label { display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--color-text-soft); margin-bottom: 6px; }

  @media (max-width: 860px) {
    .pub-hero__media { height: 260px; }
    .pub-hero__inner h1 { font-size: 24px; }
  }
</style>
