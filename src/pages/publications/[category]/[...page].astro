---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CategoryFilterTabs from '../../../components/publications/CategoryFilterTabs.astro';
import PublicationGrid from '../../../components/publications/PublicationGrid.astro';
import Pagination from '../../../components/publications/Pagination.astro';
import { publicationCategories } from '../../../content.config';
import { publicationCategoryLabels, publicationsPageSize } from '../../../data/siteConfig';
import { getLangFromUrl, localizedPath } from '../../../i18n/utils';

export const getStaticPaths = (async ({ paginate }) => {
  const all = (await getCollection('publications')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const categorySlugs = ['all', ...publicationCategories];

  return categorySlugs.flatMap((category) => {
    const entries = category === 'all' ? all : all.filter((p) => p.data.category === category);
    const pages = paginate(entries, { pageSize: publicationsPageSize, params: { category } });
    // Page 1 of "all" is served by /publications/index.astro instead, to avoid
    // duplicate content at two URLs.
    return category === 'all' ? pages.filter((p) => p.props.page.currentPage !== 1) : pages;
  });
}) satisfies GetStaticPaths;

const { category } = Astro.params;
const { page } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// Page 2 of "all" would otherwise link "prev" back to the now-removed
// /publications/all/ page 1 — send it to the real root index instead.
if (category === 'all' && page.currentPage === 2) {
  page.url.prev = localizedPath('/publications/', lang);
}

const copy = {
  en: { eyebrow: 'Publications', title: 'Publications' },
  ar: { eyebrow: 'الإصدارات', title: 'الإصدارات' },
}[lang];

const heroSubtitle =
  category === 'all'
    ? undefined
    : publicationCategoryLabels[category as string]?.[lang];

const categoryLabel = category === 'all' ? null : publicationCategoryLabels[category as string]?.[lang];
const description = categoryLabel
  ? { en: `${categoryLabel} published by Phoenix Center — an independent Palestinian research institution.`, ar: `${categoryLabel} صادرة عن مركز فينيق، مؤسسة بحثية فلسطينية مستقلة.` }[lang]
  : { en: 'Research papers, policy papers, fact sheets, and field studies published by Phoenix Center.', ar: 'أوراق بحثية، وأوراق سياسات، وأوراق حقائق، ودراسات ميدانية صادرة عن مركز فينيق.' }[lang];
---

<BaseLayout title={copy.title} description={description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} subtitle={heroSubtitle} />

  <Section variant="tight">
    <CategoryFilterTabs active={category as string} />
    {page.data.length > 0 ? (
      <PublicationGrid entries={page.data} />
    ) : (
      <p class="empty">{lang === 'ar' ? 'لا توجد إصدارات في هذا التصنيف بعد.' : 'No publications in this category yet.'}</p>
    )}
    <Pagination page={page} />
  </Section>
</BaseLayout>

<style>
  .empty { color: var(--color-text-muted); font-size: 15px; padding: 40px 0; text-align: center; }
</style>
