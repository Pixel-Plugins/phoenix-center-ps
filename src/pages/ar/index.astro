---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import PillarsGrid from '../../components/sections/PillarsGrid.astro';
import ApproachChecklist from '../../components/sections/ApproachChecklist.astro';
import PartnersGrid from '../../components/sections/PartnersGrid.astro';
import Section from '../../components/ui/Section.astro';
// Testimonials and TeamGrid components exist (src/components/sections/) but
// aren't rendered below yet — no real client quotes or team bios exist.
// Same for Newsletter — no email provider is wired up yet (see notes.md).
import PublicationGrid from '../../components/publications/PublicationGrid.astro';
import { getLangFromUrl, useTranslations, localizedPath, pickLocalized } from '../../i18n/utils';
import { hero } from '../../data/homepage';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const description = pickLocalized(hero.body, lang)?.value;

const allPublications = await getCollection('publications');
// Featured items (featured: true in frontmatter) are pinned first regardless
// of date; everything else fills remaining slots by most recent. To swap
// what shows here, just set `featured: true` on the publications you want —
// no code changes needed.
const byFeaturedThenDate = (a: (typeof allPublications)[number], b: (typeof allPublications)[number]) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
};
const books = allPublications.filter((p) => p.data.category === 'research-field-studies').sort(byFeaturedThenDate).slice(0, 4);
const papers = allPublications.filter((p) => p.data.category !== 'research-field-studies').sort(byFeaturedThenDate).slice(0, 4);
---

<BaseLayout title={lang === 'ar' ? 'الرئيسية' : 'Home'} description={description} showAnnouncement>
  <Hero />
  <PillarsGrid />
  <ApproachChecklist />

  <Section
    id="publications"
    eyebrow={t('publications.eyebrow')}
    title={t('publications.booksTitle')}
  >
    <Fragment slot="head-action">
      <a class="link-underline" href={localizedPath('/publications/', lang)}>{t('publications.viewAll')}</a>
    </Fragment>
    <PublicationGrid entries={books} />
  </Section>

  <Section variant="tight" title={t('publications.papersTitle')}>
    <Fragment slot="head-action">
      <a class="link-underline" href={localizedPath('/publications/', lang)}>{t('publications.viewAll')}</a>
    </Fragment>
    <PublicationGrid entries={papers} variant="alt" />
  </Section>

  <PartnersGrid />
</BaseLayout>
