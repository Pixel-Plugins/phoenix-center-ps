---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { siteConfig } from '../../data/siteConfig';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const copy = {
  en: {
    eyebrow: 'Get in Touch',
    title: 'Contact Us',
    subtitle: "Have a question about our research, a partnership idea, or a media request? We'd like to hear from you.",
    addressLabel: 'Address',
    phoneLabel: 'Phone',
    emailLabel: 'Email',
  },
  ar: {
    eyebrow: 'تواصل معنا',
    title: 'اتصل بنا',
    subtitle: 'هل لديك سؤال حول أبحاثنا، فكرة شراكة، أو طلب إعلامي؟ يسعدنا أن نسمع منك.',
    addressLabel: 'العنوان',
    phoneLabel: 'الهاتف',
    emailLabel: 'البريد الإلكتروني',
  },
}[lang];

const formConfigured = siteConfig.formspreeFormId && !siteConfig.formspreeFormId.startsWith('REPLACE_');
---

<BaseLayout title={copy.title} description={copy.subtitle}>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} subtitle={copy.subtitle} />

  <Section variant="tight">
    <div class="contact-grid">
      <div class="contact-info" data-reveal-stagger>
        <div class="contact-info__item">
          <h3>{copy.addressLabel}</h3>
          <p>{siteConfig.address[lang]}</p>
        </div>
        <div class="contact-info__item">
          <h3>{copy.phoneLabel}</h3>
          <p><a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`}>{siteConfig.phone}</a></p>
        </div>
        <div class="contact-info__item">
          <h3>{copy.emailLabel}</h3>
          <p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
        </div>
      </div>

      <div class="contact-form-wrap">
        <form
          data-reveal
          class="contact-form"
          action={formConfigured ? `https://formspree.io/f/${siteConfig.formspreeFormId}` : undefined}
          method="POST"
          data-contact-form
        >
          {!formConfigured && (
            <p class="contact-form__notice">
              {lang === 'ar'
                ? 'نموذج التواصل قيد الإعداد حالياً — يرجى المراسلة مباشرة عبر البريد الإلكتروني أدناه.'
                : 'This form is not fully wired up yet — please email us directly below in the meantime.'}
            </p>
          )}
          <p class="contact-form__notice" data-form-error hidden>{t('contact.errorMessage')}</p>
          <label>
            <span>{t('contact.formName')}</span>
            <input type="text" name="name" required disabled={!formConfigured} />
          </label>
          <label>
            <span>{t('contact.formEmail')}</span>
            <input type="email" name="email" required disabled={!formConfigured} />
          </label>
          <label>
            <span>{t('contact.formSubject')}</span>
            <input type="text" name="subject" disabled={!formConfigured} />
          </label>
          <label>
            <span>{t('contact.formMessage')}</span>
            <textarea name="message" rows="5" required disabled={!formConfigured}></textarea>
          </label>
          <button type="submit" class="btn-submit" disabled={!formConfigured}>{t('contact.formSubmit')}</button>
          <p class="contact-form__fallback">
            {t('contact.emailFallback')} <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </p>
        </form>

        <div class="contact-form__success" data-form-success hidden>
          <span class="contact-form__success-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 13l5 5L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3>{t('contact.successTitle')}</h3>
          <p>{t('contact.successBody')}</p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  function initContactForm() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
      const action = form.getAttribute('action');
      if (!action) return;

      const wrap = form.closest('.contact-form-wrap');
      const errorEl = form.querySelector<HTMLElement>('[data-form-error]');
      const successEl = wrap?.querySelector<HTMLElement>('[data-form-success]');
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl?.setAttribute('hidden', '');
        if (submitBtn) submitBtn.disabled = true;

        try {
          const res = await fetch(action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('Form submission failed');
          // Not `form.hidden = true` — .contact-form's own `display: flex`
          // (a class rule) beats the [hidden] UA-stylesheet default at
          // equal specificity, so the form stays visible. Inline style
          // always wins regardless of any class rule's specificity.
          form.style.display = 'none';
          successEl?.removeAttribute('hidden');
        } catch {
          errorEl?.removeAttribute('hidden');
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 56px; }
  .contact-info { display: flex; flex-direction: column; gap: 28px; }
  .contact-info__item h3 { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--eyebrow); margin: 0 0 8px; }
  .contact-info__item p { font-size: 15.5px; color: var(--color-text); margin: 0; line-height: 1.6; }
  .contact-info__item a { color: var(--color-text); text-decoration: none; }
  .contact-info__item a:hover { color: var(--eyebrow); }

  .contact-form { display: flex; flex-direction: column; gap: 18px; }
  .contact-form label { display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--color-text-strong); }
  .contact-form input, .contact-form textarea {
    font: 400 15px/1.5 var(--font-body); padding: 12px 14px; border-radius: var(--r-sm);
    border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-text);
  }
  .contact-form input:disabled, .contact-form textarea:disabled { background: var(--color-surface-alt); cursor: not-allowed; }
  .btn-submit {
    align-self: flex-start; background: var(--navy); color: var(--ink-invert); border: 0;
    padding: 13px 26px; border-radius: var(--r-sm); font-weight: 700; font-size: 14.5px;
    cursor: pointer; font-family: inherit;
  }
  .btn-submit:disabled { opacity: .5; cursor: not-allowed; }
  .contact-form__notice {
    background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--r-sm);
    padding: 12px 16px; font-size: 13.5px; color: var(--color-text-muted); margin: 0;
  }
  .contact-form__fallback { font-size: 13.5px; color: var(--color-text-muted); margin: 0; }
  .contact-form__fallback a { color: var(--eyebrow); }

  .contact-form__success {
    background: var(--color-surface-alt); border: 1px solid var(--sage);
    border-radius: var(--r-md); padding: 40px 32px; text-align: center;
  }
  .contact-form__success-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 50%; margin-bottom: 18px;
    background: var(--sage); color: var(--sage-ink);
  }
  .contact-form__success h3 { font-size: 21px; font-weight: 700; color: var(--color-text-strong); margin: 0 0 10px; }
  .contact-form__success p { font-size: 14.5px; line-height: 1.65; color: var(--color-text-muted); margin: 0; max-width: 420px; margin-inline: auto; }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
