---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Only needed when the title's own language can differ from the page's
   *  (e.g. an Arabic publication title shown on the English site) — see
   *  PublicationCard for the same per-node lang/dir pattern. */
  titleLang?: string;
  titleDir?: 'ltr' | 'rtl';
}

const { eyebrow, title, subtitle, titleLang, titleDir } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__inner">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 lang={titleLang} dir={titleDir}>{title}</h1>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    background: var(--color-surface-inverse);
    padding: 76px var(--gutter) 88px;
  }
  .page-hero__inner { max-width: 1180px; margin: 0 auto; }
  .page-hero__eyebrow {
    display: flex; align-items: center; gap: 10px; margin: 0 0 18px;
    font-size: 12.5px; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--sage);
  }
  .page-hero__eyebrow::after { content: ''; flex: 0 0 90px; width: 90px; height: 1px; background: linear-gradient(to right, var(--sage), transparent); }
  :global([dir='rtl']) .page-hero__eyebrow::after { background: linear-gradient(to left, var(--sage), transparent); }
  .page-hero h1 {
    font-size: 42px; line-height: 1.15; font-weight: 700;
    color: oklch(99% 0.005 85); margin: 0 0 18px;
  }
  .page-hero h1[dir='rtl'] { text-align: right; }
  .page-hero h1[dir='ltr'] { text-align: left; }
  .page-hero__subtitle {
    font-size: 17px; line-height: 1.6; color: var(--ink-on-navy); margin: 0; max-width: 620px;
  }

  @media (max-width: 860px) {
    .page-hero { padding: 56px var(--gutter) 64px; }
    .page-hero h1 { font-size: 30px; }
  }
</style>
