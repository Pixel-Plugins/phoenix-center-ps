---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLangFromUrl, pickLocalized, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
---

<section class="partners section section--tint">
  <p class="partners__label">{t('partners.eyebrow')}</p>
  <div class="partners__grid" data-reveal-stagger>
    {partners.map((p) => (
      <div class:list={['partner-tile', p.data.dark && 'partner-tile--dark']}>
        <Image src={p.data.logo} alt={pickLocalized(p.data.name, lang)?.value ?? ''} width={240} loading="eager" />
      </div>
    ))}
  </div>
</section>

<style>
  /* This is a plain <section>, not the <Section> component — "section
     section--tint" in its class list doesn't actually get that
     component's scoped padding/max-width (Astro scopes styles per
     component; reusing class names doesn't cross that boundary). Same bug
     as about-us.astro's .quotes section. Without this, the grid runs
     flush against the viewport edges on mobile. */
  .partners { padding: 72px var(--gutter); max-width: none; }
  .partners__label {
    text-align: center; font-size: 13px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-soft); margin: 0 0 32px;
  }
  .partners__grid {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px;
    max-width: 1200px; margin: 0 auto;
  }
  .partner-tile {
    aspect-ratio: 3/2; border: 1px solid var(--border-soft); border-radius: 10px;
    background: var(--color-surface-card);
    position: relative; overflow: hidden;
    /* Grid items default to min-width/min-height: auto, so WebKit lets the
       logo's intrinsic size (the Image component's width=240 attribute)
       force this 1fr track wider than the container instead of shrinking
       it — blowing the grid out past the viewport on mobile Safari. */
    min-width: 0; min-height: 0;
  }
  .partner-tile--dark { background: var(--navy-tile); }
  /* Sizing the logo with max-width/max-height: 100% (a percentage of the
     flex item's own box) worked in a Playwright/WebKit test build but not
     on real iOS Safari, where that percentage height didn't resolve
     against this aspect-ratio-derived box — images rendered at full
     intrinsic size instead of shrinking, blowing tiles out vertically.
     Absolutely positioning the image against the tile's padding box
     sidesteps that: percentage/inset resolution for out-of-flow elements
     is always against the already-laid-out containing block, so it isn't
     subject to the same definite-vs-auto-height ambiguity. */
  .partner-tile :global(img) {
    position: absolute; inset: 18px;
    width: calc(100% - 36px); height: calc(100% - 36px);
    object-fit: contain;
  }

  @media (max-width: 1100px) {
    .partners__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .partners__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
