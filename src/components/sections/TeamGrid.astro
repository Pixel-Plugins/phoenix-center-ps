---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getLangFromUrl, pickLocalized, localizedPath, useTranslations } from '../../i18n/utils';
import { about } from '../../data/about';
import Section from '../ui/Section.astro';

interface Props {
  limit?: number;
  showViewAll?: boolean;
  bare?: boolean;
}

const { limit, showViewAll = false, bare = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
if (limit) members = members.slice(0, limit);
---

{bare ? (
  <div class="team__grid" data-reveal-stagger>
    {members.map((m) => (
      <div class="person">
        <div class="person__photo">
          <Image src={m.data.photo} alt={m.data.name} width={140} height={140} />
        </div>
        <div>
          <div class="person__name">{m.data.name}</div>
          <div class="person__role">{pickLocalized(m.data.role, lang)?.value}</div>
        </div>
      </div>
    ))}
  </div>
) : (
  <Section id="team" eyebrow={pickLocalized(about.team.eyebrow, lang)?.value} title={pickLocalized(about.team.title, lang)?.value}>
    <Fragment slot="head-action">
      {showViewAll && <a class="link-underline" href={localizedPath('/about-us/', lang)}>{t('team.viewAll')}</a>}
    </Fragment>
    <div class="team__grid" data-reveal-stagger>
      {members.map((m) => (
        <div class="person">
          <div class="person__photo">
            <Image src={m.data.photo} alt={m.data.name} width={140} height={140} />
          </div>
          <div>
            <div class="person__name">{m.data.name}</div>
            <div class="person__role">{pickLocalized(m.data.role, lang)?.value}</div>
          </div>
        </div>
      ))}
    </div>
  </Section>
)}

<style>
  .team__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .person { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; }
  .person:nth-child(even) { margin-top: 24px; }
  .person__photo {
    width: 140px; height: 140px; border-radius: 50%; overflow: hidden;
    border: 4px solid var(--color-surface-alt); box-shadow: var(--shadow-photo);
  }
  .person__photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .person__name { font-weight: 700; font-size: 16px; color: var(--color-text-strong); }
  .person__role { font-size: 13.5px; color: oklch(50% 0.02 75); }

  @media (max-width: 1100px) {
    .team__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .team__grid { grid-template-columns: 1fr; }
    .person:nth-child(even) { margin-top: 0; }
  }
</style>
