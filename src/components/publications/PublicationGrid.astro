---
import type { CollectionEntry } from 'astro:content';
import PublicationCard from './PublicationCard.astro';

interface Props {
  entries: CollectionEntry<'publications'>[];
  variant?: 'default' | 'alt';
}

const { entries, variant = 'default' } = Astro.props;
---

<div class:list={['card-grid', variant === 'alt' && 'card-grid--alt']} data-reveal-stagger>
  {entries.map((entry) => (
    <PublicationCard entry={entry} variant={variant} />
  ))}
</div>

<style>
  .card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

  @media (max-width: 1100px) {
    .card-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
