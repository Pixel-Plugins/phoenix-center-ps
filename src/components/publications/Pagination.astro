---
import type { Page } from 'astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {page.url.prev ? (
      <a href={page.url.prev}>{t('pagination.prev')}</a>
    ) : (
      <span class="pagination__disabled">{t('pagination.prev')}</span>
    )}
    <span class="pagination__status">{page.currentPage} / {page.lastPage}</span>
    {page.url.next ? (
      <a href={page.url.next}>{t('pagination.next')}</a>
    ) : (
      <span class="pagination__disabled">{t('pagination.next')}</span>
    )}
  </nav>
)}

<style>
  .pagination { display: flex; align-items: center; justify-content: center; gap: 24px; margin-top: 56px; }
  .pagination a, .pagination__disabled {
    font-size: 14px; font-weight: 700; text-decoration: none; color: var(--color-text-strong);
  }
  .pagination a:hover { color: var(--eyebrow); }
  .pagination__disabled { color: var(--color-border); }
  .pagination__status { font-size: 13.5px; color: var(--color-text-muted); }
</style>
