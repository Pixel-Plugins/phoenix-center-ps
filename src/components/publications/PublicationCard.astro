---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, pickLocalized, localizedPath } from '../../i18n/utils';
import { publicationCategoryLabels } from '../../data/siteConfig';

interface Props {
  entry: CollectionEntry<'publications'>;
  variant?: 'default' | 'alt';
}

const { entry, variant = 'default' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const title = pickLocalized(entry.data.title, lang);
const categoryLabel = pickLocalized(publicationCategoryLabels[entry.data.category], lang);
const dateLabel = entry.data.date.toLocaleDateString(lang === 'ar' ? 'ar' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class:list={['pub-card', variant === 'alt' && 'pub-card--alt']} href={localizedPath(`/publications/${entry.id}/`, lang)}>
  <div class="pub-card__media">
    <Image src={entry.data.coverImage} alt="" width={800} />
  </div>
  <div class="pub-card__body">
    {categoryLabel && <span class="pub-card__tag">{categoryLabel.value}</span>}
    {title && (
      <h3 class="pub-card__title" lang={title.lang} dir={title.dir}>{title.value}</h3>
    )}
    <span class="pub-card__date">{dateLabel}</span>
  </div>
</a>

<style>
  .pub-card {
    display: flex; flex-direction: column; height: 380px;
    text-decoration: none; color: inherit;
    border: 1px solid var(--color-border); border-radius: var(--r-md);
    overflow: hidden; background: var(--color-surface);
    transition: border-color .2s ease, transform .25s ease, box-shadow .25s ease;
  }
  .pub-card--alt { background: var(--color-surface-alt); }
  .pub-card:hover {
    border-color: var(--sage); color: inherit;
    transform: translateY(-6px);
    box-shadow: 0 18px 32px -16px oklch(20% 0.02 75 / 0.28);
  }
  .pub-card__media {
    height: 160px; flex-shrink: 0; overflow: hidden;
    background: var(--color-surface-alt);
    display: flex; align-items: center; justify-content: center;
  }
  .pub-card--alt .pub-card__media { background: var(--color-surface); }
  .pub-card__media :global(img) {
    width: 100%; height: 100%; object-fit: contain; display: block;
    transition: transform .4s ease;
  }
  .pub-card:hover .pub-card__media :global(img) { transform: scale(1.08); }
  .pub-card__body { padding: 20px; display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0; }
  .pub-card__tag { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--tag); }
  .pub-card__title {
    font-family: var(--font-ar), var(--font-head);
    font-size: 15.5px; font-weight: 600; line-height: 1.5; color: var(--color-text-strong);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .pub-card__title[dir='rtl'] { text-align: right; }
  .pub-card__title[dir='ltr'] { text-align: left; }
  .pub-card__date { font-size: 13px; color: var(--ink-soft); margin-top: auto; }

  @media (max-width: 560px) {
    .pub-card { height: auto; min-height: 340px; }
  }
</style>
