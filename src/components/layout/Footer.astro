---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';
import { navLinks, serviceLinks } from '../../data/nav';
import { siteConfig, brand } from '../../data/siteConfig';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="footer__grid">
    <div class="footer__about">
      <div class="brand brand--footer">
        <Image class="brand__mark" src={brand.logoLight} alt={t('brand.name')} width={234} height={64} />
      </div>
      <p>{t('footer.about')}</p>
      <div class="social">
        <a href={siteConfig.social.facebook} aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12Z"/></svg>
        </a>
        <a href={siteConfig.social.instagram} aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12 2c-2.7 0-3.1 0-4.1.1-1.1 0-1.8.2-2.4.4a5 5 0 0 0-1.8 1.2A5 5 0 0 0 2.5 5.5c-.3.6-.4 1.3-.5 2.4C2 8.9 2 9.3 2 12s0 3.1.1 4.1c0 1.1.2 1.8.4 2.4a5 5 0 0 0 1.2 1.8 5 5 0 0 0 1.8 1.2c.6.3 1.3.4 2.4.5C8.9 22 9.3 22 12 22s3.1 0 4.1-.1c1.1 0 1.8-.2 2.4-.4a5 5 0 0 0 1.8-1.2 5 5 0 0 0 1.2-1.8c.3-.6.4-1.3.5-2.4.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c0-1.1-.2-1.8-.5-2.4a5 5 0 0 0-1.2-1.8 5 5 0 0 0-1.8-1.2c-.6-.3-1.3-.4-2.4-.5C15.1 2 14.7 2 12 2Zm0 1.8c2.6 0 3 0 4 .1.9 0 1.5.2 1.8.3.5.2.8.4 1.1.7.3.3.6.6.7 1.1.2.3.3.9.3 1.8.1 1 .1 1.4.1 4s0 3-.1 4c0 .9-.2 1.5-.3 1.8-.2.5-.4.8-.7 1.1-.3.3-.6.6-1.1.7-.3.2-.9.3-1.8.3-1 .1-1.4.1-4 .1s-3 0-4-.1c-.9 0-1.5-.2-1.8-.3a3 3 0 0 1-1.1-.7 3 3 0 0 1-.7-1.1c-.2-.3-.3-.9-.3-1.8-.1-1-.1-1.4-.1-4s0-3 .1-4c0-.9.2-1.5.3-1.8.2-.5.4-.8.7-1.1.3-.3.6-.6 1.1-.7.3-.2.9-.3 1.8-.3 1-.1 1.4-.1 4-.1Zm0 3a5.2 5.2 0 1 0 0 10.4A5.2 5.2 0 0 0 12 6.8Zm0 8.6a3.4 3.4 0 1 1 0-6.8 3.4 3.4 0 0 1 0 6.8Zm5.4-8.8a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z"/></svg>
        </a>
        <a href={siteConfig.social.twitter} aria-label="X">
          <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M22 5.9c-.7.3-1.5.6-2.3.7a4 4 0 0 0 1.8-2.2c-.8.5-1.6.8-2.6 1a4 4 0 0 0-6.9 3.7A11.5 11.5 0 0 1 3.7 4.6a4 4 0 0 0 1.3 5.4c-.7 0-1.3-.2-1.9-.5v.1a4 4 0 0 0 3.3 4 4 4 0 0 1-1.8.1 4 4 0 0 0 3.8 2.8A8.1 8.1 0 0 1 2 18.4a11.4 11.4 0 0 0 6.3 1.9c7.5 0 11.7-6.4 11.7-11.9v-.5c.8-.6 1.5-1.3 2-2Z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer__col">
      <h3>{t('footer.quickLinks')}</h3>
      {navLinks.map((link) => <a href={localizedPath(link.href, lang)}>{t(link.labelKey)}</a>)}
    </div>

    <div class="footer__col">
      <h3>{t('footer.services')}</h3>
      <div>
        {serviceLinks.map((s) => <a href={localizedPath(s.href, lang)}>{s.title[lang]}</a>)}
      </div>
    </div>

    <div class="footer__col">
      <h3>{t('footer.contact')}</h3>
      <p>{t('footer.addressLabel')}</p>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`}>{siteConfig.phone}</a>
    </div>
  </div>

  <div class="footer__bar">
    <span>{t('footer.rightsText').replace('2026', String(year))}</span>
    <span class="footer__legal">
      <a href={localizedPath('/privacy/', lang)}>{t('footer.privacy')}</a>
      <span aria-hidden="true"> · </span>
      <a href={localizedPath('/terms/', lang)}>{t('footer.terms')}</a>
      <span aria-hidden="true"> · </span>
      <a href="#" data-cookie-preferences>{t('footer.cookiePreferences')}</a>
      <span aria-hidden="true"> · </span>
      <a class="footer__powered-by" href="https://www.pixelplugins.com/" target="_blank" rel="noopener noreferrer">{t('footer.poweredBy')}</a>
    </span>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-surface-inverse); color: oklch(80% 0.01 80); padding: 64px var(--gutter) 28px; }
  .footer__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 40px;
  }
  .brand--footer { margin-bottom: 16px; }
  .brand--footer .brand__mark { height: 32px; width: auto; }
  .footer__about p { font-size: 14px; line-height: 1.7; color: oklch(68% 0.01 80); max-width: 300px; margin: 0 0 20px; }
  .footer__col { display: flex; flex-direction: column; gap: 12px; }
  .footer__col h3 { font-family: var(--font-body); font-weight: 700; font-size: 14px; color: oklch(96% 0.01 85); margin-bottom: 6px; }
  .footer__col a, .footer__col p { color: oklch(72% 0.01 80); text-decoration: none; font-size: 14px; margin: 0; line-height: 1.6; }
  .footer__col a:hover { color: var(--sage); }
  .footer__col > div { display: flex; flex-direction: column; gap: 12px; }

  .social { display: flex; gap: 14px; }
  .social a {
    width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid oklch(35% 0.01 80); display: flex;
    align-items: center; justify-content: center;
    color: oklch(85% 0.01 80); text-decoration: none;
  }
  .social a:hover { border-color: var(--sage); color: var(--sage); }

  .footer__bar {
    max-width: var(--max); margin: 48px auto 0; padding-top: 24px;
    border-top: 1px solid var(--navy-rule);
    font-size: 13px; color: oklch(58% 0.01 80);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
  }
  .footer__legal a { color: inherit; text-decoration: none; }
  .footer__legal a:hover { color: var(--sage); }
  .footer__legal a.footer__powered-by { color: #95DDAC; }

  @media (max-width: 1100px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer__grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
