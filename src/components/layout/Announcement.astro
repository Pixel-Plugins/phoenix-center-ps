---
import { getLangFromUrl, pickLocalized, localizedPath, useTranslations } from '../../i18n/utils';
import { getPublicationsForLang } from '../../lib/getPublications';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Always the actual most recent publication — no manual upkeep. If a new
// publication is added, this updates itself on the next build. Filtered to
// this page's language so a publication only available in the other
// language never gets linked here (its page in this locale doesn't exist).
const [latest] = (await getPublicationsForLang(lang)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const title = latest ? pickLocalized(latest.data.title, lang) : null;
---

{title && (
  <a class="announce" href={localizedPath(`/publications/${latest.id}/`, lang)}>
    <span class="announce__prefix">{t('announcement.new')}</span>
    <span class="announce__title" lang={title.lang} dir={title.dir}>{title.value}</span>
  </a>
)}

<style>
  .announce {
    display: flex; align-items: baseline; justify-content: center; gap: 8px;
    background: var(--color-surface-inverse);
    color: oklch(90% 0.02 155);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    padding: 9px 16px;
    letter-spacing: .01em;
    text-decoration: none;
    overflow: hidden;
  }
  .announce:hover { color: var(--sage); }
  .announce__prefix { flex-shrink: 0; color: var(--sage); }
  .announce__title {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    max-width: 640px;
  }

  @media (max-width: 560px) {
    .announce__title { max-width: 220px; }
  }
</style>
