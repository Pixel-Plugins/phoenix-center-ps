---
import { getLangFromUrl, pickLocalized, localizedPath } from '../../i18n/utils';
import { announcement } from '../../data/homepage';

const lang = getLangFromUrl(Astro.url);
const text = pickLocalized(announcement.text, lang);
const href = announcement.href ? localizedPath(announcement.href, lang) : undefined;
---

{text && (
  href ? (
    <a class="announce announce--link" href={href}>{text.value}</a>
  ) : (
    <div class="announce">{text.value}</div>
  )
)}

<style>
  .announce {
    display: block;
    background: var(--color-surface-inverse);
    color: oklch(90% 0.02 155);
    font-size: 13px;
    font-weight: 600;
    text-align: center;
    padding: 9px 16px;
    letter-spacing: .01em;
  }
  .announce--link { text-decoration: none; }
  .announce--link:hover { color: var(--sage); }
</style>
