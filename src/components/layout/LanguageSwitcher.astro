---
import { getLangFromUrl, alternateLangPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const enPath = alternateLangPath(Astro.url.pathname, 'en');
const arPath = alternateLangPath(Astro.url.pathname, 'ar');
---

<div class="lang-switch" role="group" aria-label="Language">
  <a href={enPath} aria-pressed={lang === 'en'}>EN</a>
  <a href={arPath} lang="ar" aria-pressed={lang === 'ar'}>عربي</a>
</div>

<style>
  .lang-switch {
    display: flex;
    gap: 2px;
    padding: 3px;
    border: 1px solid oklch(85% 0.01 80);
    border-radius: 999px;
  }
  .lang-switch a {
    border: 0;
    cursor: pointer;
    padding: 6px 12px;
    border-radius: 999px;
    font: 700 12px/1 var(--font-body);
    background: transparent;
    color: oklch(45% 0.02 75);
    text-decoration: none;
  }
  .lang-switch a[lang='ar'] { font-family: var(--font-ar); }
  .lang-switch a[aria-pressed='true'] { background: var(--gold); color: oklch(20% 0.03 75); }
</style>
