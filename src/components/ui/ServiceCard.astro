---
interface Props {
  href: string;
  title: string;
  description: string;
}

const { href, title, description } = Astro.props;
---

<a class="service-card" href={href}>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="service-card__link-icon" aria-hidden="true">→</span>
</a>

<style>
  .service-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    padding: 32px;
    text-decoration: none;
    color: inherit;
    transition: border-color .18s ease, transform .18s ease;
  }
  .service-card:hover { border-color: var(--sage); color: inherit; transform: translateY(-3px); }
  .service-card h3 { font-size: 20px; font-weight: 700; color: var(--color-text-strong); margin: 0 0 10px; }
  .service-card p { font-size: 14.5px; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 16px; }
  .service-card__link-icon {
    display: inline-block; color: var(--eyebrow); font-weight: 700;
    transition: transform .18s ease;
  }
  /* :global() on the [dir] part only — it targets <html dir="rtl">, set by
     BaseLayout.astro, a different component than this one. Without :global,
     Astro's scoping requires [dir="rtl"] to ALSO carry this component's own
     scope attribute, which <html> never has, so the rule silently never
     matches anything. */
  :global([dir='rtl']) .service-card__link-icon { transform: scaleX(-1); }
  .service-card:hover .service-card__link-icon { transform: translateX(4px); }
  :global([dir='rtl']) .service-card:hover .service-card__link-icon { transform: scaleX(-1) translateX(4px); }
</style>
