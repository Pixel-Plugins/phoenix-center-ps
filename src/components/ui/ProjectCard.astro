---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, pickLocalized } from '../../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
}

const { project, reverse = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const { title, partnerOrFunder, description, activities, pdf, image } = project.data;
---

<article class:list={['project-card', reverse && 'project-card--reverse']} data-reveal>
  <div class="project-card__media">
    <Image src={image} alt="" width={800} height={500} />
  </div>
  <div class="project-card__body">
    <p class="project-card__partner">{pickLocalized(partnerOrFunder, lang)?.value}</p>
    <h3>{pickLocalized(title, lang)?.value}</h3>
    <p class="project-card__desc">{pickLocalized(description, lang)?.value}</p>
    {activities.length > 0 && (
      <ul class="project-card__activities">
        {activities.map((a) => <li>{pickLocalized(a, lang)?.value}</li>)}
      </ul>
    )}
    {pdf && (
      <a class="link-underline" href={pdf} target="_blank" rel="noopener noreferrer">
        {lang === 'ar' ? 'تحميل PDF ←' : 'Download PDF →'}
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center;
  }
  .project-card--reverse .project-card__media { order: 2; }
  .project-card__media { border-radius: var(--r-xl); overflow: hidden; border: 1px solid var(--color-border); }
  .project-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .project-card__partner {
    font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: var(--eyebrow); margin: 0 0 10px;
  }
  .project-card__body h3 { font-size: 26px; font-weight: 700; color: var(--color-text-strong); margin: 0 0 14px; }
  .project-card__desc { font-size: 15.5px; line-height: 1.7; color: var(--color-text-muted); margin: 0 0 18px; }
  .project-card__activities { list-style: none; margin: 0 0 20px; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .project-card__activities li {
    font-size: 14.5px; color: var(--color-text); padding-inline-start: 20px; position: relative;
  }
  .project-card__activities li::before {
    content: ''; position: absolute; inset-inline-start: 0; top: 8px;
    width: 8px; height: 8px; border-radius: 50%; background: var(--sage);
  }

  @media (max-width: 860px) {
    .project-card, .project-card--reverse { grid-template-columns: 1fr; }
    .project-card--reverse .project-card__media { order: 0; }
  }
</style>
