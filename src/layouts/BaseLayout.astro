---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Announcement from '../components/layout/Announcement.astro';
import { getLangFromUrl, toCanonicalPathname } from '../i18n/utils';
import { siteConfig } from '../data/siteConfig';

interface Props {
  title: string;
  description?: string;
  /** Homepage only, per the original approved design — the announcement
   *  bar sits above the sticky header, not inside the page content. */
  showAnnouncement?: boolean;
}

const {
  title,
  description = 'Phoenix Center is an independent Palestinian non-profit institution for research and field studies.',
  showAnnouncement = false,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
// Always points at the real production URL, even when this build targeted
// the temporary GitHub Pages preview subpath — see astro.config.mjs.
const canonicalHref = new URL(toCanonicalPathname(Astro.url.pathname), siteConfig.url).toString();
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {siteConfig.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    {showAnnouncement && <Announcement />}
    <Header />
    <main id="top" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <script>
      import '../components/motion/motion.client.ts';
    </script>
  </body>
</html>
