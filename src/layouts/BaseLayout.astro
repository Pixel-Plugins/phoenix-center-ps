---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Announcement from '../components/layout/Announcement.astro';
import CookieConsent from '../components/layout/CookieConsent.astro';
import Analytics from '../components/layout/Analytics.astro';
import { getLangFromUrl, toCanonicalPathname, alternateLangPath } from '../i18n/utils';
import { siteConfig } from '../data/siteConfig';

interface Props {
  title: string;
  description?: string;
  /** Homepage only, per the original approved design — the announcement
   *  bar sits above the sticky header, not inside the page content. */
  showAnnouncement?: boolean;
  /** 'article' for publication detail pages; everything else is 'website'. */
  type?: 'website' | 'article';
  /** Article-only: ISO date string, rendered as article:published_time and JSON-LD datePublished. */
  publishedTime?: string;
  /** Extra JSON-LD block(s) for this page, alongside the sitewide Organization schema. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Per-page social preview image (already an absolute production URL — see
   *  toCanonicalPathname for why it can't just be a processed asset's raw
   *  .src). Defaults to the site logo. */
  image?: string;
}

const {
  title,
  description = 'Phoenix Center is an independent Palestinian non-profit institution for research and field studies.',
  showAnnouncement = false,
  type = 'website',
  publishedTime,
  structuredData,
  image,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
// Always points at the real production URL, even when this build targeted
// the temporary GitHub Pages preview subpath — see astro.config.mjs.
const canonicalHref = new URL(toCanonicalPathname(Astro.url.pathname), siteConfig.url).toString();
const enHref = new URL(toCanonicalPathname(alternateLangPath(Astro.url.pathname, 'en')), siteConfig.url).toString();
const arHref = new URL(toCanonicalPathname(alternateLangPath(Astro.url.pathname, 'ar')), siteConfig.url).toString();
const ogImageHref = image ?? new URL('/og-image.png', siteConfig.url).toString();
const fullTitle = `${title} — ${siteConfig.name}`;

// The site only has one real address until DNS is pointed at GitHub Pages
// (see .local/notes.md's SEO section) — until then it's also reachable at
// the temporary pixel-plugins.github.io preview subpath, which shouldn't
// get indexed as if it were the real site.
const isPreviewBuild = import.meta.env.BASE_URL !== '/';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'NGO'],
  name: siteConfig.name,
  url: siteConfig.url,
  logo: new URL('/og-image.png', siteConfig.url).toString(),
  email: siteConfig.email,
  description: 'Phoenix Center is an independent Palestinian non-profit institution for research and field studies.',
  areaServed: [
    { '@type': 'Place', name: 'Gaza Strip' },
    { '@type': 'Place', name: 'West Bank' },
    { '@type': 'Country', name: 'Palestine' },
  ],
  knowsAbout: [
    'Palestinian affairs',
    'Israeli-Palestinian conflict',
    'Gaza reconstruction',
    'Forced displacement',
    'Palestinian political studies',
    'Policy advocacy',
  ],
  address: { '@type': 'PostalAddress', streetAddress: siteConfig.address.en, addressCountry: 'PS' },
  sameAs: Object.values(siteConfig.social),
};
const structuredDataBlocks = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isPreviewBuild && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ar" href={arHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} sizes="any" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon-32x32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon-16x16.png`} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_PS' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_PS'} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageHref} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {structuredDataBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />)}

    <ClientRouter />
  </head>
  <body>
    {showAnnouncement && <Announcement />}
    <Header />
    <main id="top" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    {!isPreviewBuild && <Analytics />}
    <script>
      import '../components/motion/motion.client.ts';
    </script>
  </body>
</html>
